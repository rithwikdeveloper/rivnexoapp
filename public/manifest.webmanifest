{
  "name": "Rivnexo — Website & Android App Marketplace",
  "short_name": "Rivnexo",
  "description": "An independent marketplace for websites and verified Android apps.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "prefer_related_applications": false,
  "display_override": ["window-controls-overlay", "standalone"],
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0f8a70",
  "theme_color": "#0f8a70",
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
